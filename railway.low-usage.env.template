# Railway low-usage deployment variables
#
# Required secrets:
# GCP_KEY_PART_1=<base64 chunk 1 from gcp_key.json>
# GCP_KEY_PART_2=<base64 chunk 2 from gcp_key.json>
# GCP_KEY_PART_3=<base64 chunk 3 from gcp_key.json>
# MONGODB_URI=<MongoDB Atlas connection string>
#
# Optional Discord integrations:
# DISCORD_BOT_TOKEN=<Discord bot token>
# DISCORD_PRICE_DROP_WEBHOOK=<price drop webhook URL>
# DISCORD_NTE_WEBHOOK=<NTE webhook URL>
# DISCORD_NTE_BARGAIN_WEBHOOK=<NTE bargain webhook URL>
# DISCORD_NTE_MAXCONST_WEBHOOK=<NTE max const webhook URL>

# Cost controls. These defaults still update Google Sheets, but much less often.
MAX_PAGES=5
SCRAPE_INTERVAL_MINUTES=120
FAST_SCAN_INTERVAL_MINUTES=0
ENABLE_STARTUP_CHARTS=0

# Always-on web service mode:
START_SCRAPER=1
START_DISCORD_BOT=0

# Cron-only mode suggestion:
# Set the Railway service command to:
# python genshin_scraper_original.py --once
